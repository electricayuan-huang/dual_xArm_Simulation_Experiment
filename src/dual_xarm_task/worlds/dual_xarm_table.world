<?xml version="1.0"?>
<sdf version="1.6">
  <world name="dual_xarm_table">
    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tabletop top surface is exactly z=1.0 m. -->
    <model name="work_table">
      <static>true</static>
      <link name="table_top">
        <inertial>
          <mass>50</mass>
          <inertia><ixx>3</ixx><iyy>3</iyy><izz>3</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="top_collision">
          <pose>0 0 0.98 0 0 0</pose>
          <geometry><box><size>1.6 1.0 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.98 0 0 0</pose>
          <geometry><box><size>1.6 1.0 0.04</size></box></geometry>
          <material><ambient>0.42 0.25 0.12 1</ambient><diffuse>0.42 0.25 0.12 1</diffuse></material>
        </visual>
      </link>

      <link name="leg_front_left"><collision name="collision"><geometry><cylinder><radius>0.045</radius><length>0.98</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.045</radius><length>0.98</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient></material></visual></link>
      <joint name="leg_front_left_joint" type="fixed"><parent>table_top</parent><child>leg_front_left</child><pose>-0.70 -0.40 0.49 0 0 0</pose></joint>
      <link name="leg_front_right"><collision name="collision"><geometry><cylinder><radius>0.045</radius><length>0.98</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.045</radius><length>0.98</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient></material></visual></link>
      <joint name="leg_front_right_joint" type="fixed"><parent>table_top</parent><child>leg_front_right</child><pose>0.70 -0.40 0.49 0 0 0</pose></joint>
      <link name="leg_back_left"><collision name="collision"><geometry><cylinder><radius>0.045</radius><length>0.98</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.045</radius><length>0.98</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient></material></visual></link>
      <joint name="leg_back_left_joint" type="fixed"><parent>table_top</parent><child>leg_back_left</child><pose>-0.70 0.40 0.49 0 0 0</pose></joint>
      <link name="leg_back_right"><collision name="collision"><geometry><cylinder><radius>0.045</radius><length>0.98</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.045</radius><length>0.98</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient></material></visual></link>
      <joint name="leg_back_right_joint" type="fixed"><parent>table_top</parent><child>leg_back_right</child><pose>0.70 0.40 0.49 0 0 0</pose></joint>
    </model>

    <include>
      <uri>model://workpiece_pedestal</uri>
      <name>workpiece_pedestal</name>
      <pose>0 0.10 1.05 0 0 0</pose>
    </include>

    <include>
      <uri>model://hollow_cylinder</uri>
      <name>hollow_cylinder_workpiece</name>
      <pose>0 0.10 1.16 0 0 0</pose>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
  </world>
</sdf>
